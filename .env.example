# Causality Analyzer Environment Configuration
# Copy this file to .env and fill in your values.
# WARNING: .env is git-ignored — never commit real credentials!

# ── Docker Compose ────────────────────────────────────────────────
PORT=3000
POSTGRES_USER=causality
POSTGRES_PASSWORD=changeme
POSTGRES_DB=causality_analyzer
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_AUTH=neo4j/changeme

# ── Remote Storage (optional) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
NEO4J_URI=bolt://localhost:7687

# ── SSL/TLS (for remote connections) ─────────────────────────────
PGSSLMODE=require
# PGSSLCERT=/path/to/client-cert.pem
# PGSSLKEY=/path/to/client-key.pem
# PGSSLROOTCERT=/path/to/ca-cert.pem

# ── LLM Explainer (optional — falls back to template explanations if not set)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# LLM_TIMEOUT=15000

# ── Server Configuration ─────────────────────────────────────────
# LOG_LEVEL=info
# MAX_BODY_SIZE=10485760
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000
# CORS_ORIGIN=*

# TLS/mTLS (optional — enables HTTPS with client certificate authentication)
# CAUSALITY_TLS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# CAUSALITY_TLS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# CAUSALITY_TLS_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# CAUSALITY_TLS_PASSPHRASE="optional-key-passphrase"
# CAUSALITY_MTLS_REQUEST_CERT=true
# CAUSALITY_MTLS_REJECT_UNAUTHORIZED=true

# ── API Authentication ──────────────────────────────────────────
# CAUSALITY_API_TOKEN=your-secret-bearer-token-here
