{
  "name": "@agentix-e/causality-analyzer-storage-browser",
  "version": "1.1.0",
  "description": "Browser storage: WASM SQLite + OPFS relational + SQLite-based graph",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run --coverage",
    "browser-test": "playwright test"
  },
  "dependencies": {
    "@agentix-e/causality-analyzer-core": "workspace:*",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
